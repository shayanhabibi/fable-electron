<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net9.0</TargetFramework>
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>fable-electron</ToolCommandName>
        <PackageOutputPath>../bin</PackageOutputPath>
    </PropertyGroup>
    <ItemGroup>
      <Content Include="cache.json" />
      <Compile Include="Spec.fs" />
      <Content Include="README.md" />
    </ItemGroup>
    <ItemGroup>
      <PackageReference Include="Partas.Build" Version="0.6.2" />
      <PackageReference Include="Partas.Build.Baked" Version="0.1.1" />
      <PackageReference Include="Partas.Build.Cmd" Version="0.3.1" />
      <PackageReference Include="Partas.GitNet" Version="3.0.0" />
      <PackageReference Include="Partas.TypeProvider.BuildHelper" Version="0.2.5" />
    </ItemGroup>
    <ItemGroup>
      <ProjectReference Include="..\src\ElectronApi.Json.Parser\ElectronApi.Json.Parser.fsproj" />
    </ItemGroup>
</Project>
